{
    // Debug the plugin dialog with Ubuntu's system QGIS/Python installation.
    "version": "0.2.0",
    "configurations": [
        {
            "name": "mhm_qgis: Debug plugin dialog (Linux/QGIS)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/test_mhm_qgis.py",
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "python": "/usr/bin/python3",
            "justMyCode": false,
            "subProcess": true,
            "env": {
                "QGIS_PREFIX_PATH": "/usr",
                "QGIS_PLUGINPATH": "${workspaceFolder}",
                "PYTHONPATH": "${workspaceFolder}:/usr/share/qgis/python:/usr/share/qgis/python/plugins",
                "PYTHONUNBUFFERED": "1",

                // Force the host Qt/GTK libraries instead of paths inherited
                // from the Snap-packaged VS Code process.
                "QT_QPA_PLATFORM": "xcb",
                "QT_PLUGIN_PATH": "/usr/lib/x86_64-linux-gnu/qt5/plugins",
                "QT_QPA_PLATFORM_PLUGIN_PATH": "/usr/lib/x86_64-linux-gnu/qt5/plugins/platforms",
                "GIO_MODULE_DIR": "/usr/lib/x86_64-linux-gnu/gio/modules",
                "GDK_PIXBUF_MODULEDIR": "/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders",
                "GDK_PIXBUF_MODULE_FILE": "/usr/lib/x86_64-linux-gnu/gdk-pixbuf-2.0/2.10.0/loaders.cache",
                "GTK_EXE_PREFIX": "/usr",
                "GTK_PATH": "/usr/lib/x86_64-linux-gnu/gtk-3.0",
                "GTK_IM_MODULE_FILE": "/usr/lib/x86_64-linux-gnu/gtk-3.0/3.0.0/immodules.cache",
                "GTK_MODULES": "",
                "XDG_DATA_HOME": "${env:HOME}/.local/share",
                "XDG_DATA_DIRS": "/usr/local/share:/usr/share:/var/lib/snapd/desktop",

                "GDAL_DATA": "/usr/share/gdal",
                "PROJ_DATA": "/usr/share/proj",
                "PROJ_LIB": "/usr/share/proj"
            }
        }
    ]
}
